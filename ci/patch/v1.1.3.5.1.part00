--- a/tools/test_v11351_branding.py
+++ b/tools/test_v11351_branding.py
@@ -0,0 +1,20 @@
+from pathlib import Path
+
+root=Path(__file__).resolve().parents[1]
+strings=(root/'app/src/main/res/values/strings.xml').read_text()
+build=(root/'app/build.gradle').read_text()
+service=(root/'app/src/main/java/id/sch/smpn4dumai/esiswa/PushMessagingService.java').read_text()
+main=(root/'app/src/main/java/id/sch/smpn4dumai/esiswa/MainActivity.java').read_text()
+icon=root/'app/src/main/res/drawable-nodpi/esiswa_logo.webp'
+splash=root/'app/src/main/res/drawable-nodpi/launch_screen.jpg'
+checks={
+ 'app name (SSD) SMPN4D':'<string name="app_name">(SSD) SMPN4D</string>' in strings,
+ 'version 1.1.3.5.1 code 11':"versionName '1.1.3.5.1'" in build and 'versionCode 11' in build,
+ 'notification title renamed':'(SSD) SMPN4D' in service and "title:'(SSD) SMPN4D'" in main,
+ 'launcher asset present':icon.exists() and icon.stat().st_size>10000,
+ 'splash asset pres