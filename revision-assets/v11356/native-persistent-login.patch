         @JavascriptInterface
+        public String getPersistentSessionCredential() {
+            try {
+                SharedPreferences prefs = getSharedPreferences(AUTH_PERSIST_PREFS, Context.MODE_PRIVATE);
+                String refreshToken = prefs.getString(KEY_AUTH_REFRESH_TOKEN, "");
+                String expiresAt = prefs.getString(KEY_AUTH_EXPIRES_AT, "");
+                if (refreshToken == null || refreshToken.trim().isEmpty()) return "";
+                JSONObject out = new JSONObject();
+                out.put("refreshToken", refreshToken.trim());
+                out.put("expiresAt", expiresAt == null ? "" : expiresAt);
+                return out.toString();
+            } catch (Exception ignored) {
+                return "";
+            }
+        }
+
+        @JavascriptInterface
+        public boolean savePersistentSessionCredential(String refreshToken, String expiresAt) {
+            String token = refreshToken == null ? "" : refreshToken.trim();
+            if (token.length() < 40 || token.length() > 500) return false;
+            String exp = expiresAt == null ? "" : expiresAt.trim();
+            // commit() sengaja dipakai agar credential benar-benar tersimpan sebelum
+            // proses APK bisa ditutup oleh pengguna/OEM sesaat setelah login.
+            return getSharedPreferences(AUTH_PERSIST_PREFS, Context.MODE_PRIVATE)
+                    .edit()
+                    .putString(KEY_AUTH_REFRESH_TOKEN, token)
+                    .putString(KEY_AUTH_EXPIRES_AT, exp)
+                    .commit();
+        }
+
+        @JavascriptInterface
+        public boolean clearPersistentSessionCredential() {
+            return getSharedPreferences(AUTH_PERSIST_PREFS, Context.MODE_PRIVATE)
+                    .edit()
+                    .remove(KEY_AUTH_REFRESH_TOKEN)
+                    .remove(KEY_AUTH_EXPIRES_AT)
+                    .commit();
+        }
+
+        @JavascriptInterface
+        public boolean hasPersistentSessionCredential() {
+            String token = getSharedPreferences(AUTH_PERSIST_PREFS, Context.MODE_PRIVATE)
+                    .getString(KEY_AUTH_REFRESH_TOKEN, "");
+            return token != null && token.trim().length() >= 40;
+        }
+
