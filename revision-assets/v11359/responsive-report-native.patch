+    private boolean isGoogleDirectExportUri(Uri uri) {
+        if (uri == null || !"https".equalsIgnoreCase(uri.getScheme())) return false;
+        String host = uri.getHost();
+        String path = uri.getPath();
+        if (host == null) return false;
+        host = host.toLowerCase(Locale.ROOT);
+        path = path == null ? "" : path.toLowerCase(Locale.ROOT);
+        if (host.equals("docs.google.com") && path.contains("/export")) return true;
+        if (host.equals("drive.google.com")) {
+            String export = uri.getQueryParameter("export");
+            return "download".equalsIgnoreCase(export);
+        }
+        return false;
+    }
+
+    private boolean startNativeGoogleExportDownload(WebView source, Uri uri) {
+        if (!isGoogleDirectExportUri(uri)) return false;
+        try {
+            String url = uri.toString();
+            String guessed = URLUtil.guessFileName(url, null, null);
+            PendingDownload data = new PendingDownload(
+                    url,
+                    source == null ? null : source.getSettings().getUserAgentString(),
+                    "attachment; filename=\"" + safeFilename(guessed) + "\"",
+                    null
+            );
+            enqueueDownload(data);
+            return true;
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
