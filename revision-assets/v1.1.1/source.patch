+    private void hideLaunchOverlay() {
+        if (launchOverlay == null || launchOverlay.getVisibility() != View.VISIBLE) return;
+        launchOverlay.animate()
+                .alpha(0f)
+                .setDuration(120)
+                .withEndAction(() -> {
+                    launchOverlay.setVisibility(View.GONE);
+                    launchOverlay.setAlpha(1f);
+                })
+                .start();
+    }
