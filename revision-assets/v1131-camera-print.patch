+    private void startNativePrint(WebView source, String requestedTitle) {
+        if (source == null || isFinishing()) return;
+        try {
+            PrintManager printManager = (PrintManager) getSystemService(Context.PRINT_SERVICE);
+            if (printManager == null) {
+                toast("Layanan cetak Android tidak tersedia.");
+                return;
+            }
+            String title = requestedTitle == null ? "" : requestedTitle.trim();
+            if (title.isEmpty()) title = "E-SISWA";
+            title = title.length() > 80 ? title.substring(0, 80) : title;
+            String jobName = "E-SISWA - " + title;
+            PrintDocumentAdapter adapter = source.createPrintDocumentAdapter(jobName);
+            pendingPrintWebView = source;
+            pendingPrintLostFocus = false;
+            printManager.print(jobName, adapter, new PrintAttributes.Builder().build());
+        } catch (Exception ex) {
+            pendingPrintWebView = null;
+            pendingPrintLostFocus = false;
+            toast("Mode cetak Android gagal dibuka.");
+        }
+    }
+
+    private void dispatchAfterPrint(WebView printedView) {
+        if (printedView == null) return;
+        printedView.evaluateJavascript("(function(){try{window.dispatchEvent(new Event('afterprint'));}catch(e){}})();", null);
+    }
+
+    private final class PrintBridge {
+        private final WebView source;
+        PrintBridge(WebView source) { this.source = source; }
+
+        @JavascriptInterface
+        public void printPage(String title) {
+            runOnUiThread(() -> startNativePrint(source, title));
+        }
+    }
