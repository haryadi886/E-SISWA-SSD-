@@ -0,0 +1,30 @@
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parents[1]
+main = (root / 'app/src/main/java/id/sch/smpn4dumai/esiswa/MainActivity.java').read_text()
+build = (root / 'app/build.gradle').read_text()
+
+client_block = main[main.find('private class ESiswaWebViewClient'):main.find('private class ESiswaChromeClient')]
+viewport_block = main[main.find('private void enforceResponsiveViewport'):main.find('private void applyPopupSystemInsets')]
+
+checks = {
+    'Version 1.1.4 / code 6': "versionName '1.1.4'" in build and 'versionCode 6' in build,
+    'Restore WebView text zoom 100': 'settings.setTextZoom(100);' in main,
+    'Main viewport no forced 0.88 scale': 'MOBILE_PAGE_SCALE' not in main and 'minimum-scale=0.75' not in main,
+    'Viewport limited to main WebView': 'if (view != webView) return;' in viewport_block,
+    'Viewport applied only once in lifecycle': client_block.count('enforceResponsiveViewport(view);') == 1,
+    'No viewport injection from onPageFinished': 'public void onPageFinished' in client_block and 'onPageFinished(WebView view, String url) {\n            enforceResponsiveViewport(view);' not in client_block,
+    'Popup uses dedicated inset container': 'FrameLayout popupContainer = new FrameLayout' in main,
+    'Popup reserves real bottom margin': 'lp.bottomMargin = safeBottom;' in main,
+    'Popup navigation inset reads navigationBars': 'WindowInsets.Type.navigationBars()' in main,
+    'Popup has navigation-height fallback': 'getNavigationBarHeightPx()' in main,
+}
+
+failed = []
+for name, ok in checks.items():
+    print(('PASS' if ok else 'FAIL') + ' - ' + name)
+    if not ok:
+        failed.append(name)
+print(f"PASS {len(checks)-len(failed)}/{len(checks)} checks")
+sys.exit(1 if failed else 0)
